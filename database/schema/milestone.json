{
  "entity": "milestone",
  "title": "Payment milestone",
  "id_pattern": "^MS-[0-9]{2}$",
  "display": [
    "title",
    "percent",
    "planned_month"
  ],
  "fields": {
    "contract": {
      "type": "ref",
      "to": "contract",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "percent": {
      "type": "number",
      "unit": "%",
      "min": 0,
      "max": 100,
      "required": true
    },
    "trigger": {
      "type": "text",
      "required": true
    },
    "planned_month": {
      "type": "integer",
      "unit": "months after NTP",
      "min": 0
    },
    "security": {
      "type": "string"
    }
  }
}
