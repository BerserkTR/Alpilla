{
  "entity": "document",
  "title": "Deliverable / document register entry (MDR line)",
  "id_pattern": "^[A-Z0-9][A-Z0-9._-]*$",
  "display": [
    "title",
    "discipline",
    "doc_type",
    "status",
    "planned_ifc"
  ],
  "fields": {
    "title": {
      "type": "string",
      "required": true
    },
    "discipline": {
      "type": "enum",
      "required": true,
      "values": [
        "general",
        "process",
        "mechanical",
        "piping",
        "electrical",
        "i_and_c",
        "civil",
        "structural",
        "hvac",
        "hse",
        "commissioning",
        "project_control"
      ]
    },
    "doc_type": {
      "type": "enum",
      "required": true,
      "values": [
        "report",
        "specification",
        "datasheet",
        "list",
        "calculation",
        "drawing",
        "diagram",
        "layout",
        "isometric",
        "model",
        "procedure",
        "schedule",
        "manual",
        "study",
        "other"
      ]
    },
    "aveva_class": {
      "type": "aveva_class",
      "roots": [
        "Document"
      ],
      "description": "AVEVA class (python -m engine lib tree Document --depth 3)"
    },
    "aveva_attrs": {
      "type": "aveva_attrs",
      "class_field": "aveva_class"
    },
    "originator": {
      "type": "string",
      "description": "company producing the document"
    },
    "system": {
      "type": "ref",
      "to": "system"
    },
    "wbs": {
      "type": "ref",
      "to": "wbs"
    },
    "responsible": {
      "type": "string",
      "description": "user code of the responsible engineer"
    },
    "status": {
      "type": "enum",
      "values": [
        "planned",
        "in_progress",
        "on_hold",
        "cancelled"
      ],
      "default": "planned",
      "description": "work state; issue state comes from document_revision records"
    },
    "planned_ifr": {
      "type": "date"
    },
    "planned_ifa": {
      "type": "date"
    },
    "planned_ifc": {
      "type": "date"
    },
    "forecast_ifc": {
      "type": "date"
    },
    "weight": {
      "type": "number",
      "unit": "h",
      "min": 0,
      "description": "budget man-hours (progress weight)"
    },
    "engine": {
      "type": "string",
      "description": "engine that produces this document, if any"
    },
    "remarks": {
      "type": "text"
    }
  }
}
