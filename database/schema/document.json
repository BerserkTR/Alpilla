{
  "entity": "document",
  "title": "Deliverable / document register entry (MDL line); number = ALP-<ORG>-<KKS>-<DISC>-<TYPE>-<NNNN>",
  "id_pattern": "^ALP-[A-Z0-9]{3}-[0-9]{2}([A-Z]{3}|000)-[A-Z]{2}-[A-Z][A-Z0-9]{2}-[0-9]{4}$",
  "display": [
    "title",
    "type_code",
    "system",
    "ewp",
    "status"
  ],
  "fields": {
    "title": {
      "type": "string",
      "required": true
    },
    "discipline": {
      "type": "enum",
      "required": true,
      "values": [
        "general",
        "process",
        "mechanical",
        "piping",
        "electrical",
        "i_and_c",
        "civil",
        "structural",
        "hvac",
        "hse",
        "commissioning",
        "project_control"
      ]
    },
    "doc_type": {
      "type": "enum",
      "required": true,
      "values": [
        "report",
        "specification",
        "datasheet",
        "list",
        "calculation",
        "drawing",
        "diagram",
        "layout",
        "isometric",
        "model",
        "procedure",
        "schedule",
        "manual",
        "study",
        "other"
      ]
    },
    "aveva_class": {
      "type": "aveva_class",
      "roots": [
        "Document"
      ],
      "description": "AVEVA class (python -m engine lib tree Document --depth 3)"
    },
    "aveva_attrs": {
      "type": "aveva_attrs",
      "class_field": "aveva_class"
    },
    "originator": {
      "type": "string",
      "description": "company producing the document"
    },
    "system": {
      "type": "ref",
      "to": "system"
    },
    "wbs": {
      "type": "ref",
      "to": "wbs"
    },
    "responsible": {
      "type": "string",
      "description": "user code of the responsible engineer"
    },
    "status": {
      "type": "enum",
      "values": [
        "planned",
        "in_progress",
        "on_hold",
        "cancelled"
      ],
      "default": "planned",
      "description": "work state; issue state comes from document_revision records"
    },
    "planned_ifr": {
      "type": "date"
    },
    "planned_ifa": {
      "type": "date"
    },
    "planned_ifc": {
      "type": "date"
    },
    "forecast_ifc": {
      "type": "date"
    },
    "weight": {
      "type": "number",
      "unit": "h",
      "min": 0,
      "description": "budget man-hours (progress weight)"
    },
    "engine": {
      "type": "string",
      "description": "engine that produces this document, if any"
    },
    "remarks": {
      "type": "text"
    },
    "type_code": {
      "type": "ref",
      "to": "doc_type",
      "description": "document type of the numbering system (TYPE part of the number)"
    },
    "systems": {
      "type": "ref_list",
      "to": "system",
      "description": "further systems covered"
    },
    "cwa": {
      "type": "ref",
      "to": "cwa"
    },
    "ewp": {
      "type": "ref",
      "to": "ewp"
    },
    "mr": {
      "type": "ref",
      "to": "mr"
    },
    "equipment": {
      "type": "ref_list",
      "to": "equipment"
    },
    "inputs": {
      "type": "ref_list",
      "to": "document",
      "description": "documents this one needs (workflow network)"
    },
    "basis_refs": {
      "type": "ref_list",
      "to": [
        "source",
        "requirement",
        "decision",
        "reference",
        "tie_in",
        "scope_item",
        "guarantee",
        "permit",
        "contract_clause"
      ],
      "description": "requirements it satisfies, sources it uses"
    },
    "review": {
      "type": "enum",
      "values": [
        "approval",
        "review",
        "information",
        "internal"
      ],
      "description": "overrides the type's Owner review class"
    },
    "bdp": {
      "type": "boolean",
      "description": "part of the Basic Design Package (21-day Owner review, ER-17.01)"
    },
    "sheets": {
      "type": "integer"
    },
    "vendor_ref": {
      "type": "string",
      "description": "supplier's own document number"
    },
    "source": {
      "type": "ref",
      "to": "source",
      "description": "received file of a supplier document"
    },
    "tender": {
      "type": "boolean",
      "description": "tender-stage document: exists from the bid design, first issue (IFR) at NTP"
    },
    "rule": {
      "type": "string",
      "description": "MDL rule instance that requires this document: <rule id>|<scope key>|<part> (engine mdl sync)"
    },
    "po_weeks_ifr": {
      "type": "number",
      "unit": "weeks",
      "description": "supplier document: first issue in weeks after the PO of its MR, or before its on-site date when negative"
    },
    "po_weeks_final": {
      "type": "number",
      "unit": "weeks",
      "description": "supplier document: final issue in weeks after the PO, or relative to the on-site date when po_weeks_ifr is negative"
    },
    "duration": {
      "type": "integer",
      "min": 1,
      "unit": "working days",
      "description": "preparation duration overriding the document type (long-running deliverables such as the 3D model)"
    }
  }
}
