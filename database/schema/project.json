{
  "entity": "project",
  "title": "Project definition (normally one record)",
  "display": [
    "name",
    "plant_type",
    "configuration",
    "phase"
  ],
  "fields": {
    "name": {
      "type": "string",
      "required": true
    },
    "client": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "plant_type": {
      "type": "enum",
      "values": [
        "CCGT",
        "OCGT",
        "CHP",
        "conversion"
      ],
      "required": true
    },
    "configuration": {
      "type": "string",
      "description": "e.g. 1x1 single shaft, 2x1 multi shaft"
    },
    "gross_output_target": {
      "type": "number",
      "unit": "MW"
    },
    "tagging_system": {
      "type": "string",
      "default": "KKS",
      "description": "Plant identification system for tags"
    },
    "phase": {
      "type": "enum",
      "values": [
        "concept",
        "feasibility",
        "FEED",
        "basic",
        "detail",
        "construction",
        "operation"
      ]
    },
    "remarks": {
      "type": "text"
    },
    "schedule_start": {
      "type": "date",
      "description": "project start (CPM calendar origin)"
    },
    "data_date": {
      "type": "date",
      "description": "status date for progress and forecasts"
    },
    "work_days_per_week": {
      "type": "integer",
      "min": 5,
      "max": 7,
      "default": 5
    },
    "holidays": {
      "type": "list",
      "description": "non-working dates YYYY-MM-DD"
    }
  }
}
