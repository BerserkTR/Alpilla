#!/usr/bin/env bash
# Blocks commits that break the single source of truth (see rules.md). Activated by: python -m engine setup
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=$(command -v python3 || command -v python)
if ! "$PY" -m engine validate --pre-commit; then
  echo ""
  echo "Commit blocked: fix the errors above (python -m engine validate). Never bypass with --no-verify."
  exit 1
fi
