<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --ink:#1b1f24; --muted:#5b6470; --line:#d0d7de; --head:#1f3864; --band:#f3f6fa; }
  body { font-family: "Segoe UI", Arial, sans-serif; color: var(--ink); max-width: 1100px; margin: 24px auto; padding: 0 16px; line-height: 1.45; }
  h1 { color: var(--head); border-bottom: 3px solid var(--head); padding-bottom: 6px; }
  h2 { color: var(--head); margin-top: 28px; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; margin: 8px 0 16px; }
  th { background: var(--head); color: #fff; text-align: left; }
  th, td { border: 1px solid var(--line); padding: 5px 7px; vertical-align: top; }
  /* parameter tables (7 columns): identical column widths in every section */
  table:has(th:nth-child(7)) { table-layout: fixed; }
  table:has(th:nth-child(7)) th:nth-child(1) { width: 11%; }
  table:has(th:nth-child(7)) th:nth-child(2) { width: 22%; }
  table:has(th:nth-child(7)) th:nth-child(3) { width: 9%; }
  table:has(th:nth-child(7)) th:nth-child(4) { width: 7%; }
  table:has(th:nth-child(7)) th:nth-child(5) { width: 11%; }
  table:has(th:nth-child(7)) th:nth-child(6) { width: 9%; }
  table:has(th:nth-child(2):last-child) { width: auto; min-width: 50%; }
  tr:nth-child(even) td { background: var(--band); }
  code { background: var(--band); padding: 1px 4px; border-radius: 3px; }
  footer { margin-top: 32px; font-size: 11px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 8px; }
  @media print { body { margin: 0; max-width: none; } }
</style>
</head>
<body>
{{ body }}
<footer>Generated by engine {{ stamp.engine }} v{{ stamp.engine_version }} at {{ stamp.generated_at[:19] }}Z by {{ stamp.generated_by }} - data {{ stamp.inputs_hash }} - git {{ stamp.git_commit }}. Not to be edited by hand.</footer>
</body>
</html>
